    @property
    def rotation_euler(self) -> Vec3: ...
    @rotation_euler.setter
    def rotation_euler(self, value: Vec3) -> None: ...
    @property
    def scale(self) -> Vec3: ...
    @scale.setter
    def scale(self, value: Vec3) -> None: ...
    def set(self, transform: "Transform") -> None: ...
    def copy(self) -> Transform: ...

