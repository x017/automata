class Audio:
    """Sound playback for the current frame (ctx.audio)."""

    def play(
        self,
        path: str,
        volume: float = 1.0,
        loop_: bool = False,
        playback_rate: float = 1.0,
        panning: float = 0.0,
    ) -> int: ...
