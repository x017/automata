// A material. Entities that use it share its colour, surface and
// textures: material: "materials/hologram.mat.ron" on a Mesh Renderer. Texture paths are
// relative to this file's folder.
(
    color: (1.0, 1.0, 1.0, 1.0),
    shader: "../shaders/hologram.wgsl",
    shader_params: [0.25, 0.85, 1.0, 7.0, 0.5],
)
