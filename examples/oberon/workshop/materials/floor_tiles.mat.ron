// A material. Entities that use it share its colour, surface and
// textures: material: "materials/floor_tiles.mat.ron" on a Mesh Renderer. Texture paths are
// relative to this file's folder.
(
    color: (1.0, 1.0, 1.0, 1.0),
    roughness: 1.0,
    base_map: "../textures/tiles.png",
    normal_map: "../textures/tiles_normal.png",
    roughness_metal_map: "../textures/tiles_rm.png",
    tiling: (6.0, 5.0),
)
